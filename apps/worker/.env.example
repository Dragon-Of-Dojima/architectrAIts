# Copy this file to `.env` in apps/worker for local runs. `.env` is gitignored.
# The worker loads these via `import 'dotenv/config'` (cwd = apps/worker).
# AWS credentials are read from ~/.aws by the SDK's default provider chain.

DATABASE_URL=postgresql://architect:devpassword@localhost:5432/architectraits
S3_BUCKET=tradarchitecture-062214186260-us-east-1-an
AWS_REGION=us-east-1
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.6

# Optional: poll interval for the long-running loop (default 60000).
# WORKER_POLL_INTERVAL_MS=60000
