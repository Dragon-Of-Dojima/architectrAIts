# Copy this file to `.env` in packages/db and adjust if your dev DB
# credentials differ from the docker-compose defaults.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://architect:devpassword@localhost:5432/architectraits
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# OpenRouter (Phase 2 AI ingest). Verify the exact slug at openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.6
