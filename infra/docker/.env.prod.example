# Copy to `.env.prod` on the instance and fill in. This file is gitignored.

# --- Postgres (on-box) ---
POSTGRES_USER=architect
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password
POSTGRES_DB=architectraits

# --- S3 (same bucket as dev) ---
S3_BUCKET=tradarchitecture-062214186260-us-east-1-an
AWS_REGION=us-east-1

# --- AWS credentials for an IAM user scoped READ-ONLY to the bucket above ---
# Lightsail can't assume an IAM role, so the app uses static keys here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
